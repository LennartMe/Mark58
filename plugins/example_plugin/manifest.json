{
  "name": "example_plugin",
  "label": "Example Plugin",
  "version": "1.0",
  "description": "A template plugin showing how to extend Jarvis with custom actions.",
  "author": "Jarvis",
  "settings": {
    "enabled": {
      "label": "Enable Feature",
      "type": "bool",
      "default": true
    },
    "retry_count": {
